@page "/Index"
@model truckPRO_api.Pages.Index
@{
    ViewData["Title"] = "Truck Check Pro - Welcome";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Truck Check Pro - Welcome</title>
    <link rel="stylesheet" href="/css/index_style.css">

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Truck Check Pro - Welcome" />
    <meta property="og:description" content="Fleet Managers and Drivers working together to keep trucks safer and reduce maintenance costs. Upload safety pictures, driver shifts, and stay compliant effortlessly." />
    <meta property="og:image" content="https://truckphotos.s3.us-east-2.amazonaws.com/email_logo.png" />
    <meta property="og:url" content="https://truckcheck.org" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Truck Check Pro" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Truck Check Pro - Welcome" />
    <meta name="twitter:description" content="Fleet Managers and Drivers working together to keep trucks safer and reduce maintenance costs. Upload safety pictures, driver shifts, and stay compliant effortlessly." />
    <meta name="twitter:image" content="https://truckphotos.s3.us-east-2.amazonaws.com/email_logo.png" />
</head>
<body>
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-content">
            <h1>@Model.WelcomeMessage</h1>
            <p>
                Fleet Managers and Drivers working together to keep trucks safer and reduce maintenance costs. 
                Upload safety pictures, driver shifts, and stay compliant effortlessly.
            </p>
            <div class="actions">
                <a href="/Login" class="action-button">Log In</a>
                <a href="/Register" class="action-button secondary">Sign Up</a>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section">
        <h2>Key Features</h2>
        <div class="features">
            <div class="feature">
                <h3>Real-Time Monitoring</h3>
                <p>Access real-time driver updates and ensure compliance during shifts.</p>
            </div>
            <div class="feature">
                <h3>Pre-Shift Safety Checks</h3>
                <p>Drivers upload safety pictures for approval before getting on the road.</p>
            </div>
            <div class="feature">
                <h3>Cost Reduction</h3>
                <p>Prevent costly repairs by addressing safety issues before they escalate.</p>
            </div>
        </div>
    </section>
</body>
</html>