@page "/Index"
@model truckPRO_api.Pages.Index
@{
    ViewData["Title"] = "Truck Check Pro - Welcome";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Truck Check Pro - Welcome</title>
    <!-- Link your CSS file -->
    <link rel="stylesheet" href="/css/index_style.css">
    
</head>
<body>
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-content">
            <h1>@Model.WelcomeMessage</h1>
            <p>
                Fleet Managers and Drivers working together to keep trucks safer and reduce maintenance costs. 
                Upload safety pictures, driver shifts, and stay compliant effortlessly.
            </p>
            <div class="actions">
                <a href="/Account/Login" class="action-button">Log In</a>
                <a href="/Register" class="action-button secondary">Sign Up</a>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section">
        <h2>Key Features</h2>
        <div class="features">
            <div class="feature">
                <h3>Real-Time Monitoring</h3>
                <p>Access real-time driver updates and ensure compliance during shifts.</p>
            </div>
            <div class="feature">
                <h3>Pre-Shift Safety Checks</h3>
                <p>Drivers upload safety pictures for approval before getting on the road.</p>
            </div>
            <div class="feature">
                <h3>Cost Reduction</h3>
                <p>Prevent costly repairs by addressing safety issues before they escalate.</p>
            </div>
        </div>
    </section>
</body>
</html>