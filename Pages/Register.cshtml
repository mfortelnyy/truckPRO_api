@page "/Register"
@using truckPRO_api.Pages
@model RegisterModel
@{
    ViewData["Title"] = "Sign Up";
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"]</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" 
        rel="stylesheet" 
        integrity="sha384-KyZXEJ1QK5a8k3c8x+vb45XhvgAl2VjFOpffEjDqYmYc0bd10PtnuB5rFL5Vq71Q" 
        crossorigin="anonymous">
  <link rel="stylesheet" href="/css/registration_style.css">
</head>
<body>
  <div class="main-container">
    <header class="app-bar">
      @ViewData["Title"]
    </header>
    <div class="container">
      <p class="instructions">Please fill out the form below to register as a driver.</p>

      @if (TempData["ErrorMessage"] != null)
      {
        <div class="alert alert-danger">
          <strong>Error:</strong> @TempData["ErrorMessage"]
        </div>
      }

      <form method="post" action="/sign-up-from-page">
        <div class="form-group">
          <label for="FirstName">First Name</label>
          <input type="text" id="FirstName" name="FirstName" class="form-input" 
                 value="@Model.SignUpDTO.FirstName" required />
        </div>
        <div class="form-group">
          <label for="LastName">Last Name</label>
          <input type="text" id="LastName" name="LastName" class="form-input" 
                 value="@Model.SignUpDTO.LastName" required />
        </div>
        <div class="form-group">
          <label for="Email">Email</label>
          <input type="email" id="Email" name="Email" class="form-input" 
                 value="@Model.SignUpDTO.Email" required />
        </div>
        <div class="form-group">
          <label for="Phone">Phone Number</label>
          <input type="text" id="Phone" name="Phone" class="form-input" 
                 value="@Model.SignUpDTO.Phone" required />
        </div>
        <div class="form-group">
          <label for="Password">Password</label>
          <input type="password" id="Password" name="Password" class="form-input" required />
        </div>
        <div class="form-group">
          <label for="ConfirmPassword">Confirm Password</label>
          <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-input" required />
        </div>
        <div class="form-group">
          <label for="Role">Role</label>
          <select id="Role" name="Role" class="form-select" required>
            <option value="2" @(Model.SignUpDTO.Role == 2 ? "selected" : "")>Driver</option>
            <option value="1" @(Model.SignUpDTO.Role == 3 ? "selected" : "")>Manager</option>
          </select>
        </div>
        <div class="form-group">
          <label for="CompanyId">Select Company</label>
          <select id="CompanyId" name="CompanyId" class="form-select">
            @foreach (var company in Model.Companies)
            {
              <option value="@company.Id" @(Model.SignUpDTO.CompanyId == company.Id ? "selected" : "")>
                @company.Name
              </option>
            }
          </select>
        </div>
        <button type="submit" class="action-button">Sign Up</button>
      </form>

      <div class="login-footer">
        Already have an account? <a href="/login">Sign In</a>
      </div>
    </div>
  </div>

  <!-- Optional Loading Spinner -->
  <div id="spinner" class="spinner-border text-orange" style="display: none;" role="status">
    <span class="visually-hidden">Loading...</span>
  </div>

  <!-- Scripts -->
  <script src="js/registration_script.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" 
          integrity="sha384-7dOXY9Hh5pmGvvKkPf78g2wNoOB8k9iZghhLFg2jiBszlgQKz0NJkAqEdQTfPzZY" 
          crossorigin="anonymous"></script>
</body>
</html>